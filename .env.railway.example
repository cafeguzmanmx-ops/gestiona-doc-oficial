# Gestiona Doc 1.0 - Variables generales para despliegue Railway
# No subir valores reales a GitHub. Usar el panel Variables de cada servicio en Railway.

# API service
NODE_ENV=production
PORT=3000
DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=generate-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
APP_URL=https://tu-frontend.railway.app
API_URL=https://tu-api.railway.app/api
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_MB=10
BOOTSTRAP_TOKEN=generate-a-temporary-bootstrap-token-with-32-plus-characters

# Web service
VITE_API_URL=https://tu-api.railway.app/api
VITE_APP_NAME=Gestiona Doc
